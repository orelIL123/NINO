# Copy to .env.local and fill in. Nothing here is required for the demo to run.

# Public site URL — used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://nino-boutique.co.il

# --- Firebase (client SDK, safe to expose) ----------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — never expose) ----------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Shopify (headless storefront) ------------------------------------------
# The store's myshopify domain, no protocol.
SHOPIFY_STORE_DOMAIN=p9xvga-8t.myshopify.com

# Storefront API access token. Shopify admin ->  Settings -> Apps and sales
# channels -> Develop apps -> <your app> -> API credentials ->
# "Storefront API access token". This is a PUBLIC, read-only credential.
#
# Do NOT put the Admin API token (shpat_...) or the app secret key (shpss_...)
# here — neither belongs in a storefront and both grant write access.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version (quarterly). Override if the default falls out of support.
SHOPIFY_API_VERSION=2026-01

# --- Payment provider ---------------------------------------------------------
# Not needed with Shopify — Shopify Checkout handles payment, tax and shipping.
