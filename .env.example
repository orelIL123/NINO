# Copy to .env.local and fill in. Nothing here is required for the demo to run.

# Public site URL — used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://nino-boutique.co.il

# --- Firebase (client SDK, safe to expose) ----------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — never expose) ----------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Shopify (headless storefront) ------------------------------------------
# The store's myshopify domain, no protocol.
SHOPIFY_STORE_DOMAIN=p9xvga-8t.myshopify.com

# Optional public Storefront API access token for token-gated fields.
# Products, collections, search and carts work tokenlessly on current APIs.
#
# Do NOT put the Admin API token (shpat_...) or the app secret key (shpss_...)
# here — neither belongs in a storefront and both grant write access.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API token for the private /admin product manager. Server-only.
# Required scopes: write_products, read_products, write_inventory,
# read_inventory, read_locations, write_publications, read_publications,
# write_translations, read_translations, write_files, read_files.
# Never prefix this variable with NEXT_PUBLIC_.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Storefront API version (quarterly). Override if the default falls out of support.
SHOPIFY_API_VERSION=2026-01

# --- Private NINO product admin (/admin) ------------------------------------
# Password used to enter the private product manager.
ADMIN_PANEL_PASSWORD=

# Random signing key, at least 32 characters. Generate with:
# openssl rand -base64 48
ADMIN_SESSION_SECRET=

# --- Lead delivery (newsletter + contact form) -------------------------------
# Without these, submissions are still validated and written to the server log
# (Vercel -> Project -> Logs) so nothing is lost. Add them to get email instead.
RESEND_API_KEY=
LEADS_FORWARD_TO=
LEADS_FROM=

# --- Payment provider ---------------------------------------------------------
# Not needed with Shopify — Shopify Checkout handles payment, tax and shipping.
