# Copy to .env.local and fill in. Nothing here is required for the demo to run.

# Public site URL — used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://nino-boutique.co.il

# --- Firebase (client SDK, safe to expose) ----------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — never expose) ----------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Payment provider (added later) -----------------------------------------
# PAYMENT_PROVIDER=
# PAYMENT_TERMINAL_ID=
# PAYMENT_API_KEY=
